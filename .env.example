NETATLAS_ENVIRONMENT=production
NETATLAS_DEBUG=false
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_PASSWORD=change-me-rabbitmq
NETATLAS_MASTER_KEY_B64=
NETATLAS_JWT_PRIVATE_KEY_PEM=
NETATLAS_JWT_PUBLIC_KEY_PEM=
NETATLAS_BOOTSTRAP_ADMIN_USERNAME=admin
NETATLAS_BOOTSTRAP_ADMIN_PASSWORD=
NETATLAS_BOOTSTRAP_ADMIN_EMAIL=admin@netatlas.local
NETATLAS_HTTPS_PORT=443
NETATLAS_HTTP_PORT=80
NETATLAS_TLS_DIR=./deploy/certs

# Onboard observability
NETATLAS_SYSLOG_UDP_PORT=514
NETATLAS_SYSLOG_TCP_PORT=514
NETATLAS_SYSLOG_RETENTION_DAYS=30
NETATLAS_TRIGGER_EVAL_INTERVAL_SECONDS=30
NETATLAS_SMTP_HOST=
NETATLAS_SMTP_PORT=587
NETATLAS_SMTP_USERNAME=
NETATLAS_SMTP_PASSWORD=
NETATLAS_SMTP_FROM=netatlas@localhost
NETATLAS_SMTP_USE_TLS=true
NETATLAS_ALERT_MAIL_TO=
